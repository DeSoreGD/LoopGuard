{
  "manifest_version": 3,
  "name": "LoopGuard",
  "short_name": "LoopGuard",
  "version": "0.1.0",
  "description": "Local LoopGuard companion for website blocking and desktop app status.",
  "key": "",
  "incognito": "split",
  "permissions": ["nativeMessaging", "tabs", "alarms", "declarativeNetRequest"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://youtube.com/*", "*://*.youtube.com/*"],
      "js": ["content_scripts/youtube_spa.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LoopGuard"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
